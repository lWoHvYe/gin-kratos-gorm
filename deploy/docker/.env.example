# Copy to deploy/docker/.env before starting the simulation stack.
#
# MySQL is the DTM transaction store. It is NOT started by this compose file.
# Use a host MySQL (default host.docker.internal) or point MYSQL_HOST at an
# existing container that is reachable from this compose network.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=dtm

# DTM registers this endpoint in etcd. The host services in this project call
# DTM directly through DTM_ADDRESS=127.0.0.1:36790, so this only matters for
# consumers that discover DTM through etcd.
DTM_ENDPOINT=grpc://host.docker.internal:36790
DTM_ETCD_TARGET=etcd://etcd:2379/dtmservice

# etcd advertise URL. Containers use etcd:2379; host clients connect through
# 127.0.0.1:2379 and normally work because etcd clients use the supplied
# endpoint for a single-node cluster.
ETCD_ADVERTISE_URL=http://etcd:2379
