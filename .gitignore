# Reference https://github.com/github/gitignore/blob/master/Go.gitignore

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.dylib

# Test binary, built with `go test -c`
*.test

# Coverage output
*.out
coverage.out
*.coverprofile

# Build output
bin/
dist/

# Go workspace file
go.work
go.work.sum

# Dependency directories (remove the comment below to include it)
vendor/

# Generated protobuf code is committed under api/gen for reproducible builds.
*.pb.go
*_gen.go
!**/wire_gen.go
!api/gen/**/*.pb.go

# Compiled object files, static and dynamic libraries
*.o
*.a
*.so

# Local caches and temporary files
.tmp/
tmp/
.gocache/

# Local databases / test artifacts
*.db
*.sqlite
*.sqlite3
data/

# Logs
*.log

# Local configuration and secrets
.env
deploy/compose/.env
*.cert
*.key

# OS / editor files
Thumbs.db
.DS_Store
.vscode/
.idea/
*.swp

# Frontend
/.pnpm-store/
frontend/node_modules/
frontend/.pnpm-store/
frontend/**/node_modules/
frontend/**/dist/
frontend/**/.nuxt/
frontend/**/.output/
frontend/**/coverage/
frontend/**/playwright-report/
frontend/**/test-results/
frontend/e2e/test-results/
frontend/e2e/playwright-report/
frontend/test-results/
frontend/playwright-report/
frontend/.turbo/
frontend/**/*.tsbuildinfo
frontend/**/vite.config.ts.timestamp-*

# Stray root-level binaries from `go build ./cmd/<service>` (no -o).
/gateway
/admin
/identity
/catalog
/inventory
/cart
/pricing
/order
/payment
/fulfillment
/aftersales
/seckill
