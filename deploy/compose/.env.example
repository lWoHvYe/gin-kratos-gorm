# Copy to deploy/compose/.env before running the make targets:
#
#   cp deploy/compose/.env.example deploy/compose/.env
#
# The Makefile passes this file to `docker compose --env-file` when it exists.
# Never commit deploy/compose/.env.

# Environment reported by structured logs (APP_ENV) and the log level.
APP_ENV=dev
LOG_LEVEL=info

# Tag used for the locally built mall/<service> images.
IMAGE_TAG=dev

# JWT signing secret. Must be at least 16 characters; replace it anywhere that
# is not a throwaway local environment.
JWT_SECRET=dev-only-change-me-32-characters

# Empty means payment runs in mock mode and accepts unsigned callbacks (a
# warning is logged). Set a value to enforce the HMAC callback signature.
PAYMENT_SECRET=

# Grafana credentials for the optional observability profile.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Tracing (optional): run the tempo profile and point services at it.
# OTEL_EXPORTER_OTLP_ENDPOINT=tempo:4317
# OTEL_TRACES_SAMPLER_ARG=1
