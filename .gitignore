# Reference https://github.com/github/gitignore/blob/master/Go.gitignore

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.dylib

# Test binary, built with `go test -c`
*.test

# Coverage output
*.out
coverage.out
*.coverprofile

# Build output
bin/
dist/

# Go workspace file
go.work
go.work.sum

# Dependency directories (remove the comment below to include it)
vendor/

# Generated protobuf code is committed under api/gen for reproducible builds.
*.pb.go
*_gen.go
!api/gen/**/*.pb.go

# Compiled object files, static and dynamic libraries
*.o
*.a
*.so

# Local caches and temporary files
.tmp/
tmp/
.gocache/

# Local databases / test artifacts
*.db
*.sqlite
*.sqlite3
data/

# Logs
*.log

# Local configuration and secrets
.env
deploy/compose/.env
*.cert
*.key

# OS / editor files
Thumbs.db
.DS_Store
.vscode/
.idea/
*.swp
